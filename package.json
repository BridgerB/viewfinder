{
	"name": "viewfinder",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.5.3",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check --env-file .env.example --include-main-module=false && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check --env-file .env.example --include-main-module=false && wrangler types --check -c cloud/sight/wrangler.jsonc cloud/sight/worker-configuration.d.ts --include-main-module=false && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p cloud/sight",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "wrangler types --env-file .env.example --include-main-module=false && wrangler types -c cloud/sight/wrangler.jsonc cloud/sight/worker-configuration.d.ts --include-main-module=false",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"lint": "biome check",
		"format": "biome format --write",
		"sight": "sight/target/release/sight serve data/elevation/envi/n41w112 data/elevation/field/n41w112.hzn,data/elevation/field/n41w112-rough500.hzn --host 0.0.0.0",
		"sight:build": "cargo build --release --manifest-path sight/Cargo.toml",
		"deploy:sight": "wrangler deploy -c cloud/sight/wrangler.jsonc",
		"deploy": "pnpm build && wrangler deploy"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@bridgerb/port-from-name": "^1.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^5.1.0",
		"auth": "^1.7.25",
		"better-auth": "^1.7.25",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"lefthook": "^2.2.2",
		"playwright": "^1.65.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.162.0"
	},
	"dependencies": {
		"leaflet": "^1.9.4",
		"leaflet.heat": "^0.2.0"
	}
}
