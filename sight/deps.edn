{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.3"}}
 :aliases {:run {:main-opts ["-m" "viewfinder.main"]}
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}
           :bench {:extra-paths ["test"]
                   :extra-deps {criterium/criterium {:mvn/version "0.4.6"}}}
           :profile {:extra-deps {com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.6.1"}}
                     :jvm-opts ["-Djdk.attach.allowAttachSelf" "-XX:+UnlockDiagnosticVMOptions"
                                "-XX:+DebugNonSafepoints"]}}}
