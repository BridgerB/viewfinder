{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "viewfinder",
	"compatibility_date": "2026-11-18",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB"
		}
	]
}
