{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "viewfinder",
	"compatibility_date": "2026-11-18",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [
		{
			"pattern": "viewfinder.bridgerb.com",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "viewfinder",
			"database_id": "ddad20a8-8da3-4942-932d-f26b699649a9",
			"migrations_dir": "drizzle"
		}
	],
	// The locator's container Worker (cloud/sight); /api/sight/* forwards to it.
	"services": [
		{
			"binding": "SIGHT",
			"service": "viewfinder-sight"
		}
	]
}
